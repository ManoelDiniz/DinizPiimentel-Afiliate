# Exemplo de variáveis de ambiente (OPCIONAL)
# Copie este arquivo para .env.local e preencha com seus dados

# Google Analytics ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Informações do site
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
